+  - '@tsrs/linux-x64-gnu@0.18.0-ts7.1.0-dev.20260929'
+  - '@tsrs/linux-x64-musl@0.18.0-ts7.1.0-dev.20260929'
+
+minimumReleaseAge: 10080
+ignoreScripts: true
