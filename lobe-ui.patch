From a2cc999afa997acba0a2c5ce191ed1212901faa6 Mon Sep 17 00:00:00 2001
From: MaySoMusician <maysomusician@gmail.com>
Date: Mon, 2 Nov 2026 03:54:27 +0000
Subject: [PATCH 1/7] Change font list for Japanese

Co-Authored-By: Claude Opus 5.5 <claude@anthropic.com.invalid>
---
 src/styles/theme/token/font.test.ts | 88 ++++++++++++++++++-----------
 src/styles/theme/token/font.ts      | 46 ++++-----------
 2 files changed, 67 insertions(+), 67 deletions(-)

diff --git a/src/styles/theme/token/font.test.ts b/src/styles/theme/token/font.test.ts
index afc328bd..f2880881 100644
--- a/src/styles/theme/token/font.test.ts
+++ b/src/styles/theme/token/font.test.ts
@@ -8,13 +8,33 @@ const before = (stack: string, a: string, b: string) => {
   expect(list.indexOf(a)).toBeLessThan(list.indexOf(b));
 };
 
+const CHINESE_FAMILY =
+  /HarmonyOS|PingFang|Microsoft (YaHei|JhengHei)|Hiragino Sans (GB|CNS)|Source Han Sans (SC|TC|HC)|Noto Sans CJK (SC|TC|HK)/;
+
+const ALL_LOCALES = [
+  undefined,
+  'en-US',
+  'zh',
+  'zh-CN',
+  'zh-SG',
+  'zh-Hans',
+  'zh-TW',
+  'zh-HK',
+  'zh-MO',
+  'zh-Hant',
+  'zh-Hant-TW',
+  'ja-JP',
+  'ko-KR',
+];
+
 describe('genFontFamily', () => {
-  it('leads with Geist and keeps the SC families as the CJK fallback', () => {
+  it('leads with IBM Plex Sans JP and puts Noto Color Emoji first among emoji', () => {
     const stack = genFontFamily();
 
-    expect(fonts(stack)[0]).toBe('Geist');
-    before(stack, '"HarmonyOS Sans SC"', 'ui-sans-serif');
-    before(stack, 'sans-serif', '"Apple Color Emoji"');
+    expect(fonts(stack)[0]).toBe('"IBM Plex Sans JP"');
+    expect(fonts(stack)).not.toContain('Geist');
+    before(stack, 'sans-serif', '"Noto Color Emoji"');
+    before(stack, '"Noto Color Emoji"', '"Apple Color Emoji"');
   });
 
   it('never emits comment markers as font names', () => {
@@ -24,34 +44,37 @@ describe('genFontFamily', () => {
     }
   });
 
-  it('pairs HarmonyOS Sans with HarmonyOS Sans SC for simplified chinese', () => {
-    for (const locale of ['zh', 'zh-CN', 'zh-SG', 'zh-Hans']) {
-      const stack = genFontFamily({ locale });
-
-      expect(fonts(stack)[0]).toBe('"HarmonyOS Sans"');
-      expect(fonts(stack)).not.toContain('Geist');
-      before(stack, '"HarmonyOS Sans SC"', '"PingFang SC"');
+  it('never names a Chinese font family for any locale', () => {
+    for (const locale of ALL_LOCALES) {
+      expect(genFontFamily({ locale })).not.toMatch(CHINESE_FAMILY);
+      expect(genFontFamilyCode({ locale })).not.toMatch(CHINESE_FAMILY);
     }
   });
 
-  it('keeps traditional chinese on system fonts only', () => {
-    for (const locale of ['zh-TW', 'zh-HK', 'zh-MO', 'zh-Hant', 'zh-Hant-TW']) {
+  it('gives every chinese locale the IBM Plex + Japanese stack', () => {
+    const japanese = genFontFamily({ locale: 'ja-JP' });
+
+    for (const locale of [
+      'zh',
+      'zh-CN',
+      'zh-SG',
+      'zh-Hans',
+      'zh-TW',
+      'zh-HK',
+      'zh-MO',
+      'zh-Hant',
+    ]) {
       const stack = genFontFamily({ locale });
 
-      expect(stack).not.toContain('HarmonyOS');
-      expect(fonts(stack)).not.toContain('Geist');
-      before(stack, '"PingFang TC"', '"PingFang SC"');
+      expect(stack).toBe(japanese);
+      expect(fonts(stack)[0]).toBe('"IBM Plex Sans JP"');
+      before(stack, '"IBM Plex Sans JP"', '"Hiragino Sans"');
     }
   });
 
-  it('prefers the hong kong families for zh-HK and zh-MO', () => {
-    before(genFontFamily({ locale: 'zh-HK' }), '"PingFang HK"', '"PingFang TC"');
-    before(genFontFamily({ locale: 'zh-MO' }), '"PingFang MO"', '"PingFang TC"');
-  });
-
-  it('puts the locale CJK families ahead of the SC fallback', () => {
-    before(genFontFamily({ locale: 'ja-JP' }), '"Hiragino Sans"', '"HarmonyOS Sans SC"');
-    before(genFontFamily({ locale: 'ko-KR' }), '"Apple SD Gothic Neo"', '"HarmonyOS Sans SC"');
+  it('puts the locale CJK families after IBM Plex', () => {
+    before(genFontFamily({ locale: 'ja-JP' }), '"IBM Plex Sans JP"', '"Hiragino Sans"');
+    before(genFontFamily({ locale: 'ko-KR' }), '"IBM Plex Sans JP"', '"Apple SD Gothic Neo"');
   });
 
   it('adds script families for arabic and persian', () => {
@@ -69,21 +92,22 @@ describe('genFontFamily', () => {
   it('prepends custom fonts and leaves composed lists untouched', () => {
     const stack = genFontFamily({ prepend: [' LXGW WenKai ', 'Foo, "Bar Baz"', '', undefined] });
 
-    expect(stack.startsWith('"LXGW WenKai",Foo, "Bar Baz",Geist,')).toBe(true);
+    expect(stack.startsWith('"LXGW WenKai",Foo, "Bar Baz","IBM Plex Sans JP",')).toBe(true);
   });
 });
 
 describe('genFontFamilyCode', () => {
-  it('leads with Geist Mono and ends on monospace before emoji', () => {
+  it('leads with Mgen+ 1mn and ends on monospace before emoji', () => {
     const stack = genFontFamilyCode();
 
-    expect(fonts(stack)[0]).toBe('"Geist Mono"');
-    before(stack, '"HarmonyOS Sans SC"', 'monospace');
-    before(stack, 'monospace', '"Apple Color Emoji"');
+    expect(fonts(stack)[0]).toBe('"Mgen+ 1mn"');
+    expect(fonts(stack)).not.toContain('"Geist Mono"');
+    before(stack, 'monospace', '"Noto Color Emoji"');
   });
 
-  it('uses the locale CJK families for code too', () => {
-    before(genFontFamilyCode({ locale: 'ja-JP' }), '"Hiragino Sans"', '"HarmonyOS Sans SC"');
-    expect(genFontFamilyCode({ locale: 'zh-TW' })).not.toContain('HarmonyOS');
+  it('uses the Japanese families for code in japanese and chinese locales', () => {
+    for (const locale of ['ja-JP', 'zh-CN', 'zh-TW']) {
+      before(genFontFamilyCode({ locale }), '"Mgen+ 1mn"', '"Hiragino Sans"');
+    }
   });
 });
diff --git a/src/styles/theme/token/font.ts b/src/styles/theme/token/font.ts
index 49ea42e3..526336cc 100644
--- a/src/styles/theme/token/font.ts
+++ b/src/styles/theme/token/font.ts
@@ -8,12 +8,10 @@ const SYSTEM_SANS = [
   'Arial',
 ];
 
-const LATIN = ['Geist', ...SYSTEM_SANS];
-
-const LATIN_ZH_HANS = ['HarmonyOS Sans', ...SYSTEM_SANS];
+const LATIN = ['IBM Plex Sans JP', ...SYSTEM_SANS];
 
 const CODE = [
-  'Geist Mono',
+  'Mgen+ 1mn',
   'ui-monospace',
   'SFMono-Regular',
   'SF Mono',
@@ -23,29 +21,7 @@ const CODE = [
   'Liberation Mono',
 ];
 
-const SC_SYSTEM = [
-  'PingFang SC',
-  'Hiragino Sans GB',
-  'Microsoft YaHei UI',
-  'Microsoft YaHei',
-  'Source Han Sans SC',
-  'Noto Sans CJK SC',
-];
-
-const SC = ['HarmonyOS Sans SC', ...SC_SYSTEM];
-
-const TC = [
-  'PingFang TC',
-  'Hiragino Sans CNS',
-  'Microsoft JhengHei UI',
-  'Microsoft JhengHei',
-  'Source Han Sans TC',
-  'Noto Sans CJK TC',
-];
-
-const HK = ['PingFang HK', 'Source Han Sans HC', 'Noto Sans CJK HK', ...TC];
-
-const MO = ['PingFang MO', ...HK];
+const SC: string[] = [];
 
 const JP = [
   'Hiragino Sans',
@@ -71,7 +47,7 @@ const FALLBACK = ['ui-sans-serif', 'system-ui', 'sans-serif'];
 
 const FALLBACK_CODE = ['monospace'];
 
-const EMOJI = ['Apple Color Emoji', 'Segoe UI Emoji', 'Segoe UI Symbol', 'Noto Color Emoji'];
+const EMOJI = ['Noto Color Emoji', 'Apple Color Emoji', 'Segoe UI Emoji', 'Segoe UI Symbol'];
 
 interface LocaleFonts {
   langs: string[];
@@ -80,15 +56,15 @@ interface LocaleFonts {
   sc?: string[];
 }
 
-// Han glyphs differ per region and the first CJK family in the stack wins, so a locale's own
-// families go ahead of the SC fallback. Traditional chinese stays on system fonts because
-// HarmonyOS Sans SC draws traditional characters with mainland glyph shapes.
+// Han glyphs differ per region and the first CJK family in the stack wins. MSM never names a
+// Chinese family: every Chinese locale uses the IBM Plex + Japanese stack, so Han characters
+// render with Japanese glyph shapes instead of falling back to an OS Chinese font.
 // Later entries are more specific: the generated :lang() rules rely on this source order.
 export const LOCALE_FONTS: LocaleFonts[] = [
-  { langs: ['zh'], latin: LATIN_ZH_HANS },
-  { langs: ['zh-TW', 'zh-Hant'], latin: SYSTEM_SANS, local: TC, sc: SC_SYSTEM },
-  { langs: ['zh-HK'], latin: SYSTEM_SANS, local: HK, sc: SC_SYSTEM },
-  { langs: ['zh-MO'], latin: SYSTEM_SANS, local: MO, sc: SC_SYSTEM },
+  { langs: ['zh'], local: JP },
+  { langs: ['zh-TW', 'zh-Hant'], local: JP },
+  { langs: ['zh-HK'], local: JP },
+  { langs: ['zh-MO'], local: JP },
   { langs: ['ja'], local: JP },
   { langs: ['ko'], local: KR },
   { langs: ['ar', 'fa'], local: ARABIC },
-- 
