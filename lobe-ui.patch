diff --git a/src/styles/theme/token/base.ts b/src/styles/theme/token/base.ts
index 05bf5ef..02e37d6 100644
--- a/src/styles/theme/token/base.ts
+++ b/src/styles/theme/token/base.ts
@@ -2,7 +2,6 @@ import { AliasToken } from 'antd/es/theme/interface';
 
 const FONT_EMOJI = `"Segoe UI Emoji","Segoe UI Symbol","Apple Color Emoji","Twemoji Mozilla","Noto Color Emoji","Android Emoji"`;
 const FONT_EN = `"IBM Plex Sans JP","Segoe UI","SF Pro Display",-apple-system,BlinkMacSystemFont,Roboto,Oxygen,Ubuntu,Cantarell,"Open Sans","Helvetica Neue",sans-serif`;
-const FONT_CN = ``;
 const FONT_CODE = `"Mgen+ 1mn",ui-monospace,SFMono-Regular,SF Mono,Menlo,Consolas,Liberation Mono,monospace`;
 
 export const baseToken: Partial<AliasToken> = {
@@ -11,6 +10,6 @@ export const baseToken: Partial<AliasToken> = {
   borderRadiusSM: 3,
   borderRadiusXS: 3,
   controlHeight: 36,
