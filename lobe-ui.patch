The install policy now lives in pnpm-workspace.yaml: ignore dependency
scripts, keep @lobehub/ui on the age exclude list, and link that package
to this checkout.

Co-authored-by: Cursor Grok 4.7 <cursoragent@cursor.com.invalid>
---
 pnpm-workspace.yaml | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/pnpm-workspace.yaml b/pnpm-workspace.yaml
index 0873f34a..5bb75fb1 100644
--- a/pnpm-workspace.yaml
+++ b/pnpm-workspace.yaml
@@ -21,6 +21,7 @@ publicHoistPattern:
 
 overrides:
   katex: ^0.19.0
+  '@lobehub/ui': 'link:.'
 
 patchedDependencies:
   conventional-changelog-gitmoji-config@1.5.2: patches/conventional-changelog-gitmoji-config@1.5.2.patch
@@ -55,3 +56,15 @@ minimumReleaseAgeExclude:
   - '@lobehub/stylelint-config@2.1.6'
   - '@lobehub/docs-kit@6.2.1'
   - '@pierre/highlights@0.2.0'
+  - '@lobehub/ui'
+  - '@pierre/diffs@1.6.1'
+  - '@pierre/theming@1.0.2'
+  - tsrs@0.18.0-ts7.1.0-dev.20260929
+  - '@tsrs/darwin-arm64@0.18.0-ts7.1.0-dev.20260929'
+  - '@tsrs/linux-arm64-gnu@0.18.0-ts7.1.0-dev.20260929'
