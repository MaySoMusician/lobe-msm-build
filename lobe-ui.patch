From da72eb02534962b39c0226da446560a6b6a41347 Mon Sep 17 00:00:00 2001
From: MaySoMusician <maysomusician@gmail.com>
Date: Mon, 2 Nov 2026 03:54:46 +0000
Subject: [PATCH 7/7] =?UTF-8?q?=F0=9F=94=92=EF=B8=8F=20build(deps):=20enfo?=
 =?UTF-8?q?rce=20a=207-day=20pnpm=20release=20age?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The install policy now lives in pnpm-workspace.yaml: ignore dependency
scripts, keep @lobehub/ui on the age exclude list, and link that package
to this checkout.

Co-Authored-By: Claude Opus 5.5 <claude@anthropic.com.invalid>
---
 pnpm-workspace.yaml | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/pnpm-workspace.yaml b/pnpm-workspace.yaml
index 0873f34a..1ae328fe 100644
--- a/pnpm-workspace.yaml
+++ b/pnpm-workspace.yaml
@@ -21,6 +21,7 @@ publicHoistPattern:
 
 overrides:
   katex: ^0.19.0
+  '@lobehub/ui': 'link:.'
 
 patchedDependencies:
   conventional-changelog-gitmoji-config@1.5.2: patches/conventional-changelog-gitmoji-config@1.5.2.patch
@@ -55,3 +56,7 @@ minimumReleaseAgeExclude:
   - '@lobehub/stylelint-config@2.1.6'
   - '@lobehub/docs-kit@6.2.1'
   - '@pierre/highlights@0.2.0'
+  - '@lobehub/ui'
+
+minimumReleaseAge: 10080
+ignoreScripts: true
-- 
