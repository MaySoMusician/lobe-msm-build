diff --git a/src/features/PageEditor/usePageReadOnlyView.ts b/src/features/PageEditor/usePageReadOnlyView.ts
new file mode 100644
index 0000000000..a76e6e95bd
--- /dev/null
+++ b/src/features/PageEditor/usePageReadOnlyView.ts
@@ -0,0 +1,32 @@
+'use client';
+
+import { useResourceAccess } from '@/features/ResourcePermission/useResourceAccess';
+import { usePermission } from '@/hooks/usePermission';
+
+import { usePageEditorStore } from './store';
+import { usePageLockedByOther } from './usePageLockedByOther';
+
+/**
+ * Whether the page body shows as rendered Markdown instead of the plain-text editor.
+ *
+ * True only while the page stays unwritable for this user: no edit permission,
+ * view-level access, another member holding the lock, or a view-only / blocked
+ * collaboration room. Transient read-only states (lock pending, an agent writing,
+ * the room still syncing) keep the editor, so it is ready the moment they end and
+ * an agent's live writes stay visible where they happen.
+ */
+export const usePageReadOnlyView = (): boolean => {
+  const { allowed: hasEditPermission } = usePermission('edit_own_content');
+  const documentId = usePageEditorStore((s) => s.documentId);
+  const isWorkspacePage = usePageEditorStore((s) => s.isWorkspacePage);
+  const isLockedByOther = usePageLockedByOther();
+  const { canEditResource } = useResourceAccess(
+    'document',
+    isWorkspacePage && documentId ? documentId : undefined,
+  );
+  const collabReadOnly = usePageEditorStore(
+    (s) => !!s.collab && (s.collab.access !== 'edit' || !!s.collab.blocked),
+  );
+
+  return !hasEditPermission || !canEditResource || isLockedByOther || collabReadOnly;
+};
