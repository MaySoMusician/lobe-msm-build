--- /dev/null
+++ b/src/features/Conversation/Messages/components/Extras/Usage/UsageDetail/usageCost.ts
@@ -0,0 +1,113 @@
+import { computeChatCost } from '@lobechat/model-runtime/computeChatCost';
+import type { ModelUsage } from '@lobechat/types';
+import type { Pricing, PricingUnitName } from 'model-bank';
+
+export interface UsageUsdCost {
+  inputAudio: number;
+  inputCached: number;
+  inputCachedWrite: number;
+  inputCacheMiss: number;
+  inputCitation: number;
+  inputText: number;
+  inputTool: number;
+  outputAudio: number;
+  outputImage: number;
+  outputReasoning: number;
+  outputText: number;
+  total: number;
+  totalOutput: number;
+}
+
+interface CostBucket {
+  cost: number;
+  quantity: number;
+}
+
+const take = (bucket: CostBucket, tokens: number) => {
+  const used = Math.min(Math.max(tokens, 0), bucket.quantity);
+  if (used <= 0 || bucket.quantity <= 0 || bucket.cost <= 0) return 0;
+
+  const cost = (bucket.cost * used) / bucket.quantity;
+  bucket.cost -= cost;
+  bucket.quantity -= used;
+  return cost;
+};
+
+/**
+ * USD for the usage popover, from whatever price list the model card carries.
+ * Returns undefined when the price list cannot be applied, so the popover stays on token counts.
+ */
+export const getUsageUsdCost = (
+  pricing: Pricing | undefined,
+  usage: ModelUsage,
+): UsageUsdCost | undefined => {
+  if (!pricing) return undefined;
+
+  let result: ReturnType<typeof computeChatCost>;
+  try {
+    result = computeChatCost(pricing, usage);
+  } catch {
+    return undefined;
+  }
+  if (!result) return undefined;
+
+  const costOf = (name: PricingUnitName) =>
+    result.breakdown
+      .filter((item) => item.unit.name === name)
+      .reduce((sum, item) => sum + item.cost, 0);
+  const quantityOf = (name: PricingUnitName) =>
+    result.breakdown
+      .filter((item) => item.unit.name === name)
+      .reduce((sum, item) => sum + item.quantity, 0);
+
+  const textInputCost = costOf('textInput');
+  const textInputQuantity = quantityOf('textInput');
+  const audioInputCost = costOf('audioInput');
+
+  const inputSplit: CostBucket = { cost: textInputCost, quantity: textInputQuantity };
+  const inputTool = take(inputSplit, usage.inputToolTokens ?? 0);
+  const foldedAudio = take(inputSplit, audioInputCost > 0 ? 0 : (usage.inputAudioTokens ?? 0));
+  const inputCitation = take(inputSplit, usage.inputCitationTokens ?? 0);
+  const inputText = Math.max(0, inputSplit.cost);
+  const inputAudio = audioInputCost + foldedAudio;
+  const inputCacheMiss =
+    Math.max(0, textInputCost - inputTool) +
+    costOf('imageInput') +
+    costOf('videoInput') +
+    audioInputCost;
+  const inputCached =
+    costOf('textInput_cacheRead') + costOf('imageInput_cacheRead') + costOf('audioInput_cacheRead');
+  const inputCachedWrite = costOf('textInput_cacheWrite');
+
+  const textOutputCost = costOf('textOutput');
+  const imageOutputCost = costOf('imageOutput');
+  const audioOutputCost = costOf('audioOutput');
+  const outputSplit: CostBucket = {
+    cost: textOutputCost,
+    quantity: quantityOf('textOutput'),
+  };
+  const outputReasoning = take(outputSplit, usage.outputReasoningTokens ?? 0);
+  const imageFromText = imageOutputCost > 0 ? 0 : take(outputSplit, usage.outputImageTokens ?? 0);
+  const audioFromText = audioOutputCost > 0 ? 0 : take(outputSplit, usage.outputAudioTokens ?? 0);
+  const outputText = Math.max(0, outputSplit.cost);
+  const outputImage = imageOutputCost + imageFromText;
+  const outputAudio = audioOutputCost + audioFromText;
+  const totalOutput =
+    textOutputCost + imageOutputCost + audioOutputCost + costOf('videoGeneration');
+
+  return {
+    inputAudio,
+    inputCacheMiss,
+    inputCached,
+    inputCachedWrite,
+    inputCitation,
+    inputText,
+    inputTool,
+    outputAudio,
+    outputImage,
+    outputReasoning,
+    outputText,
+    total: result.totalCost,
+    totalOutput,
+  };
+};
