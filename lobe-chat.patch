+        events.push({
+          item_id: item.id,
+          output_index: 1, // dummy placeholder
+          part: {
+            text: '', // dummy placeholder
+            type: 'summary_text',
+          },
+          sequence_number: seq++,
+          summary_index: 1, // dummy placeholder
+          type: 'response.reasoning_summary_part.added',
+        });
