+function convertNonStreamingResponseToStreamEvents(
+  nonStreamingResponse: OpenAI.Responses.Response,
+): OpenAI.Responses.ResponseStreamEvent[] {
+  const events: OpenAI.Responses.ResponseStreamEvent[] = [];
+  let seq = 1;
+
+  // 1. First, create the "response.created" event.
+  events.push({
+    response: {
+      ...nonStreamingResponse,
+      output: [],
+      output_text: '',
+      status:
+        nonStreamingResponse.status === 'completed' ? 'in_progress' : nonStreamingResponse.status,
+      usage: undefined,
+    },
+    sequence_number: seq++,
+    type: 'response.created',
+  });
+
+  // 2. Traverse the output array and generate events according to each item's type.
+  for (const [outputIndex, item] of (nonStreamingResponse.output ?? []).entries()) {
+    const isToolCall = item.type === 'function_call' || item.type === 'custom_tool_call';
+
+    // Send the "response.output_item.added" event first.
+    // A tool call goes out whole, with its real index: the stream parser keys `responseTools`
+    // by `output_index` and reads `namespace` from this item.
+    events.push({
+      item: isToolCall
+        ? { ...item }
+        : {
+            arguments: (item as any).arguments,
+            call_id: (item as any).call_id,
+            content: (item as any).content,
+            encrypted_content: (item as any).encrypted_content,
+            id: item.id,
+            input: (item as any).input,
+            name: (item as any).name,
+            role: (item as any).role,
+            status: (item as any).status,
+            summary: (item as any).summary,
+            type: item.type,
+          },
+      ...(isToolCall && { output_index: outputIndex }),
+      sequence_number: seq++,
+      type: 'response.output_item.added',
+    } as any);
+
+    // Branch processing according to item.type.
+    switch (item.type) {
+      case 'custom_tool_call':
+      case 'function_call': {
+        // In src/utils/fetch/fetchSSE.ts, the argument duplication occurs during parse, so we won't send a delta.
+        // A custom tool call carries its input on the added item. Treat it like a function call so a
+        // tool-only response is not dropped.
+        events.push({
+          item: { ...item },
+          output_index: outputIndex,
+          sequence_number: seq++,
+          type: 'response.output_item.done',
+        });
+        break;
+      }
+
+      case 'message': {
+        // For "message" type, send the entire content as a single "response.output_text.delta" event.
+        if (item.content) {
+          for (const contentObj of item.content) {
+            if (
+              contentObj.type === 'output_text' &&
+              typeof contentObj.text === 'string' &&
+              contentObj.text.length > 0
+            ) {
+              // Combine text into a single delta.
+              events.push({
+                content_index: 1, // dummy placeholder
+                delta: contentObj.text,
+                item_id: item.id,
+                output_index: 1, // dummy placeholder
+                sequence_number: seq++,
+                type: 'response.output_text.delta',
+                logprobs: [], // dummy placeholder
+              });
+
+              // If there are annotations, send them individually as "response.output_text.annotation.added" events.
+              if (Array.isArray(contentObj.annotations)) {
+                for (const ann of contentObj.annotations) {
+                  const ann2 = ann as OpenAI.Responses.ResponseOutputText.URLCitation;
+                  events.push({
+                    annotation: {
+                      end_index: ann2.end_index,
+                      start_index: ann2.start_index,
+                      title: ann2.title,
+                      type: 'url_citation',
+                      url: ann2.url,
+                    },
+                    item_id: item.id,
+                    sequence_number: seq++,
+                    type: 'response.output_text.annotation.added' as any,
+                  });
+                }
               }
-              break;
-            }
-            /**
-             * A completed tool call already carries its full arguments/input. The stream parser
-             * reads them from `output_item.added`, so no argument deltas are needed; dropping
-             * this item would turn a tool-call-only response into an empty completion.
-             */
-            case 'custom_tool_call':
-            case 'function_call': {
-              controller.enqueue({
-                item: output,
-                output_index: outputIndex,
-                sequence_number: outputIndex,
-                type: 'response.output_item.added',
-              } as OpenAI.Responses.ResponseOutputItemAddedEvent);
-              break;
             }
           }
+        }
+
+        // Finally, send "response.output_item.done".
+        events.push({
+          item: {
+            content: [], // dummy placeholder
+            id: item.id,
+            role: 'assistant', // dummy placeholder
+            status: 'in_progress', // dummy placeholder
+            type: 'message',
+          },
+          output_index: 1, // dummy placeholder
+          sequence_number: seq++,
+          type: 'response.output_item.done',
         });
+        break;
       }
 
-      // Always send response.completed event
-      controller.enqueue({
-        response: data,
-        sequence_number: 999,
-        type: 'response.completed',
-      } as OpenAI.Responses.ResponseStreamEvent);
+      case 'reasoning': {
+        // For "reasoning" type, send the summary all at once.
+        // (In transformOpenAIStream, the events go in the order "response.reasoning_summary_part.added" -> "response.reasoning_summary_text.delta" -> done.)
+        events.push({
+          item_id: item.id,
+          output_index: 1, // dummy placeholder
+          part: {
+            text: '', // dummy placeholder
+            type: 'summary_text',
+          },
+          sequence_number: seq++,
+          summary_index: 1, // dummy placeholder
+          type: 'response.reasoning_summary_part.added',
+        });
+
+        // If there's a summary array, concatenate it into a single delta.
+        const entireSummary = Array.isArray(item.summary)
+          ? item.summary
+              .map((summary) => (typeof summary === 'string' ? summary : summary.text))
+              .filter(Boolean)
+              .join('\n')
+          : '';
+        if (entireSummary) {
+          events.push({
+            delta: entireSummary,
+            item_id: item.id,
+            output_index: 1, // dummy placeholder
+            sequence_number: seq++,
+            summary_index: 1, // dummy placeholder
+            type: 'response.reasoning_summary_text.delta',
+          });
+        }
+
+        events.push({
+          item: {
+            encrypted_content: item.encrypted_content,
+            id: item.id,
+            summary: [], // dummy placeholder
+            type: 'reasoning',
+          },
+          output_index: 1, // dummy placeholder
+          sequence_number: seq++,
+          type: 'response.output_item.done',
+        });
+        break;
+      }
+
+      default: {
+        // For an unknown type, just send "response.output_item.done".
+        events.push({
+          item: {
+            id: item.id,
+            type: item.type,
+          },
+          sequence_number: seq++,
+          type: 'response.output_item.done',
+        } as any);
+        break;
+      }
+    }
+  }
+
+  // 3. Finally, send the "response.completed" event.
+  events.push({
+    response: {
+      ...nonStreamingResponse,
+      output: [],
+      output_text: '',
+      usage: nonStreamingResponse.usage ?? undefined,
+    },
+    sequence_number: seq,
+    type: 'response.completed',
+  });
 
+  return events;
+}
+
+/**
+ * transform the OpenAI Response API data to stream format for non-streaming responses
+ */
+export const transformResponseAPIToStream = (data: OpenAI.Responses.Response) =>
+  new ReadableStream({
+    start(controller) {
+      const events = convertNonStreamingResponseToStreamEvents(data);
+
+      for (const event of events) {
+        controller.enqueue(event);
+      }
       controller.close();
     },
   });
