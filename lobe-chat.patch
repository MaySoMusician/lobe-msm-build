From 757ef62a9a165a2c148d2e934470684c1df64839 Mon Sep 17 00:00:00 2001
From: MaySoMusician <maysomusician@gmail.com>
Date: Fri, 7 Feb 2025 08:28:43 +0000
Subject: [PATCH 3/3] Show only English and Japanese option for language
 options in global menu

---
 src/features/User/UserPanel/LangButton.tsx | 12 +++++++-----
 1 file changed, 7 insertions(+), 5 deletions(-)

diff --git a/src/features/User/UserPanel/LangButton.tsx b/src/features/User/UserPanel/LangButton.tsx
index 1e380f8d..564d4ae7 100644
--- a/src/features/User/UserPanel/LangButton.tsx
+++ b/src/features/User/UserPanel/LangButton.tsx
@@ -26,11 +26,13 @@ const LangButton = memo<{ placement?: PopoverProps['placement'] }>(({ placement
         label: t('settingTheme.lang.autoMode'),
         onClick: () => switchLocale('auto'),
       },
-      ...localeOptions.map((item) => ({
-        key: item.value,
-        label: item.label,
-        onClick: () => switchLocale(item.value),
-      })),
+      ...localeOptions
+        .filter((item) => ['en-US', 'ja-JP'].includes(item.value))
+        .map((item) => ({
+          key: item.value,
+          label: item.label,
+          onClick: () => switchLocale(item.value),
+        })),
     ],
     [t],
   );
-- 
