diff --git a/packages/model-runtime/src/core/openaiCompatible/timeout.ts b/packages/model-runtime/src/core/openaiCompatible/timeout.ts
new file mode 100644
index 0000000000..894a3c87dc
--- /dev/null
+++ b/packages/model-runtime/src/core/openaiCompatible/timeout.ts
@@ -0,0 +1,119 @@
+export const DEFAULT_OPENAI_TIMEOUT = 3_600_000;
+
+export interface OpenAIClientNetworkOptions {
+  fetch?: typeof fetch;
+  fetchOptions?: { dispatcher: unknown };
+  timeout: number;
+}
+
+type UndiciModule = {
+  Agent: new (options?: { bodyTimeout?: number; headersTimeout?: number }) => unknown;
+  fetch: typeof fetch;
+};
+
+/**
+ * Prefer the undici instance installed by `src/instrumentation.ts` (same package
+ * as the global dispatcher). Fall back to a hidden require for non-Next runners.
+ */
+const loadUndici = (): UndiciModule | undefined => {
+  if (typeof window !== 'undefined') return undefined;
+  if (typeof process === 'undefined' || !process.versions?.node) return undefined;
+
+  const fromInstrumentation = (globalThis as typeof globalThis & { __LOBE_UNDICI__?: UndiciModule })
+    .__LOBE_UNDICI__;
+  if (fromInstrumentation) return fromInstrumentation;
+
+  try {
+    // Hide from Vite; works when the module graph is CJS.
+    const nodeRequire = eval('require') as NodeRequire;
+    return nodeRequire('undici') as UndiciModule;
+  } catch {
+    // ESM / Next: require is undefined
+  }
+
+  try {
+    const nodeModule = process.getBuiltinModule?.('module') as
+      { createRequire: (filename: string) => NodeRequire } | undefined;
+    if (!nodeModule?.createRequire) return undefined;
+    return nodeModule.createRequire(`${process.cwd()}/package.json`)('undici') as UndiciModule;
+  } catch {
+    return undefined;
+  }
+};
+
+/**
+ * Align OpenAI SDK abort timer with undici headers/body idle timeouts.
+ * Without a matching Agent on the same fetch implementation, Node's default
+ * undici agent still aborts at 300s (× SDK retries ≈ 900s).
+ */
+let loggedUndiciApply = false;
+
+export const resolveOpenAIClientNetworkOptions = (
+  timeoutMs: number = DEFAULT_OPENAI_TIMEOUT,
+): OpenAIClientNetworkOptions => {
+  const timeout = Number.isFinite(timeoutMs) && timeoutMs >= 0 ? timeoutMs : DEFAULT_OPENAI_TIMEOUT;
+
+  const undici = loadUndici();
+  if (!undici) {
+    console.warn(
+      '[model-runtime] undici Agent unavailable — relying on instrumentation global fetch if present. timeoutMs=%s',
+      timeout,
+    );
+    return { timeout };
+  }
+
+  const dispatcher = new undici.Agent({
+    bodyTimeout: timeout,
+    headersTimeout: timeout,
+  });
+
+  if (!loggedUndiciApply) {
+    loggedUndiciApply = true;
+    const source = (globalThis as typeof globalThis & { __LOBE_UNDICI__?: UndiciModule })
+      .__LOBE_UNDICI__
+      ? 'instrumentation'
+      : 'require';
+    console.info(
+      `[model-runtime] OpenAI undici Agent applied timeoutMs=${timeout} source=${source}`,
+    );
+  }
+
+  return {
+    fetch: undici.fetch as unknown as typeof fetch,
+    fetchOptions: { dispatcher },
+    timeout,
+  };
+};
+
+/**
+ * Self-host client defaults, shared by every place that builds an OpenAI client:
+ * never auto-retry upstream (timeouts/5xx would re-bill the same prompt), use the
+ * first numeric timeout candidate (else one hour), and align undici headers/body
+ * timeouts with it. A caller-supplied fetch is kept (it must stay on its own undici).
+ */
+export const applyOpenAIClientNetworkDefaults = <O extends Record<string, any>>(
+  initOptions: O,
+  timeoutCandidates: unknown[] = [initOptions.timeout],
+): O & { maxRetries: 0; timeout: number } => {
+  const explicitTimeout = timeoutCandidates.find(
+    (candidate): candidate is number => typeof candidate === 'number',
+  );
+  const resolvedTimeout = explicitTimeout ?? DEFAULT_OPENAI_TIMEOUT;
+  const networkOptions = resolveOpenAIClientNetworkOptions(resolvedTimeout);
+
+  const options: Record<string, any> = {
+    ...initOptions,
+    maxRetries: 0,
+    timeout: resolvedTimeout,
+  };
+
+  if (!options.fetch && networkOptions.fetch) {
+    options.fetch = networkOptions.fetch;
+    options.fetchOptions = {
+      ...(options.fetchOptions as object | undefined),
+      ...networkOptions.fetchOptions,
+    };
+  }
+
+  return options as O & { maxRetries: 0; timeout: number };
+};
