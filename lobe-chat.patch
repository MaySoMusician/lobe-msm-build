index 0000000000..f8be91441f
--- /dev/null
+++ b/src/libs/editor/plainText/plainEditorData.ts
@@ -0,0 +1,104 @@
+import { EMPTY_EDITOR_STATE } from '../constants';
+
+interface SerializedNodeLike {
+  children?: unknown;
+  format?: unknown;
+  label?: unknown;
+  text?: unknown;
+  type?: unknown;
+}
+
+const RICH_BLOCK_TYPES = new Set(['heading', 'quote']);
+
+const childrenOf = (node: SerializedNodeLike): SerializedNodeLike[] =>
+  Array.isArray(node.children)
+    ? (node.children.filter((child) => typeof child === 'object' && child) as SerializedNodeLike[])
+    : [];
+
+const isRichNode = (node: SerializedNodeLike): boolean => {
+  if (typeof node.type === 'string' && RICH_BLOCK_TYPES.has(node.type)) return true;
+  if (node.type === 'text' && typeof node.format === 'number' && node.format !== 0) return true;
+  return childrenOf(node).some(isRichNode);
+};
+
+const rootOf = (editorData: unknown): SerializedNodeLike | undefined => {
+  if (!editorData || typeof editorData !== 'object') return undefined;
+  const root = (editorData as { root?: unknown }).root;
+  return root && typeof root === 'object' ? (root as SerializedNodeLike) : undefined;
+};
+
+/**
+ * True when saved editor JSON holds formatting a plain-text editor would hide:
+ * headings, quotes, or formatted text. Such documents load from their Markdown
+ * text instead, which keeps the formatting visible as source.
+ * Node types the plain editor doesn't register (lists, tables, code blocks) still
+ * fail to load as JSON, and `loadPlainDocument` falls back to the text for those.
+ */
+export const hasRichEditorNodes = (editorData: unknown): boolean => {
+  const root = rootOf(editorData);
+  return root ? isRichNode(root) : false;
+};
+
+const textOf = (node: SerializedNodeLike): string => {
+  if (typeof node.text === 'string') return node.text;
+  if (node.type === 'linebreak') return '\n';
+  if (node.type === 'tab') return '\t';
+  if (typeof node.label === 'string') return node.label;
+  return childrenOf(node).map(textOf).join('');
+};
+
+/** The visible text of saved editor JSON, one line per top-level block. */
+export const extractPlainText = (editorData: unknown): string => {
+  const root = rootOf(editorData);
+  return root ? childrenOf(root).map(textOf).join('\n') : '';
+};
+
+/**
+ * Saved JSON worth loading: any non-empty object except the childless root shell,
+ * which Lexical rejects. Mirrors the checks the upstream loaders apply.
+ */
+const isLoadableEditorData = (editorData: unknown): boolean => {
+  if (!editorData || typeof editorData !== 'object') return false;
+  if (Object.keys(editorData).length === 0) return false;
+  const root = rootOf(editorData);
+  return !(root && Array.isArray(root.children) && root.children.length === 0);
+};
+
+interface PlainDocumentEditor {
+  setDocument: (type: string, content: any, options?: Record<string, unknown>) => void;
+}
+
+interface PlainDocumentSource {
+  editorData?: unknown;
+  markdown?: string | null;
+}
+
+/**
+ * Load saved content into a plain-text editor without ever blanking it.
+ * Chip-bearing JSON loads as is; formatted or unloadable JSON falls back to the
+ * Markdown text (or, without one, to the JSON's own text).
+ * Returns which source was loaded.
+ */
+export const loadPlainDocument = (
+  editor: PlainDocumentEditor,
+  { editorData, markdown }: PlainDocumentSource,
+  options?: Record<string, unknown>,
+): 'json' | 'markdown' | 'empty' => {
+  if (isLoadableEditorData(editorData) && !hasRichEditorNodes(editorData)) {
+    try {
+      editor.setDocument('json', editorData, options);
+      return 'json';
+    } catch (error) {
+      console.warn('[PlainText] Falling back to text for saved editor data', error);
+    }
+  }
+
+  const text = markdown || extractPlainText(editorData);
+  if (text) {
+    editor.setDocument('markdown', text, options);
+    return 'markdown';
+  }
+
+  editor.setDocument('json', EMPTY_EDITOR_STATE, options);
+  return 'empty';
+};
