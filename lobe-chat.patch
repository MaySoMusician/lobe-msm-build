+  const fromInstrumentation = (globalThis as typeof globalThis & { __LOBE_UNDICI__?: UndiciModule })
+    .__LOBE_UNDICI__;
+  if (fromInstrumentation) return fromInstrumentation;
+
+  try {
+    // Hide from Vite; works when the module graph is CJS.
+    const nodeRequire = eval('require') as NodeRequire;
+    return nodeRequire('undici') as UndiciModule;
+  } catch {
+    // ESM / Next: require is undefined
+  }
+
+  try {
+    const nodeModule = process.getBuiltinModule?.('module') as
+      { createRequire: (filename: string) => NodeRequire } | undefined;
+    if (!nodeModule?.createRequire) return undefined;
+    return nodeModule.createRequire(`${process.cwd()}/package.json`)('undici') as UndiciModule;
+  } catch {
+    return undefined;
+  }
