MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Co-Authored-By: Claude Opus 5.5 <claude@anthropic.com.invalid>
---
 .dockerignore |  1 +
 Dockerfile    | 22 ++++++++++++++++++----
 2 files changed, 19 insertions(+), 4 deletions(-)

diff --git a/.dockerignore b/.dockerignore
index fc4c2e7966..020c7d1022 100644
--- a/.dockerignore
+++ b/.dockerignore
@@ -1,6 +1,7 @@
 Dockerfile
 .dockerignore
 node_modules
+.pnpm-store
 npm-debug.log
 .next
 .git
diff --git a/Dockerfile b/Dockerfile
index 924acdc3eb..7104f6ab31 100644
--- a/Dockerfile
+++ b/Dockerfile
@@ -1,9 +1,13 @@
 ## Set global build ENV
-ARG NODEJS_VERSION="24"
+ARG NODEJS_VERSION="24.22.3"
 
 ## Base image for all building stages
 FROM node:${NODEJS_VERSION}-slim AS base
 
+ENV PNPM_CONFIG_FETCH_RETRIES=5
+ENV PNPM_CONFIG_FETCH_RETRY_MINTIMEOUT=30000
+ENV PNPM_CONFIG_NETWORK_CONCURRENCY=8
+
 ARG USE_CN_MIRROR
 
 ENV DEBIAN_FRONTEND="noninteractive"
@@ -30,6 +34,7 @@ RUN set -e && \
 FROM base AS builder
 
 ARG USE_CN_MIRROR
+ARG NPM_REGISTRY=""
 ARG NEXT_PUBLIC_BASE_PATH
 ARG NEXT_PUBLIC_SENTRY_DSN
 ARG NEXT_PUBLIC_ANALYTICS_UMAMI
@@ -79,15 +84,24 @@ RUN set -e && \
         npm config set registry "https://registry.npmmirror.com/"; \
         echo 'canvas_binary_host_mirror=https://npmmirror.com/mirrors/canvas' >> .npmrc; \
     fi && \
+    if [ -n "${NPM_REGISTRY:-}" ]; then \
+        npm config set registry "${NPM_REGISTRY}"; \
+    fi && \
     export COREPACK_NPM_REGISTRY=$(npm config get registry | sed 's/\/$//') && \
-    npm i -g corepack@latest && \
     corepack enable && \
     corepack use $(sed -n 's/.*"packageManager": "\(.*\)".*/\1/p' package.json) && \
     pnpm i && \
     mkdir -p /deps && \
     cd /deps && \
     echo '{"name":"deps","private":true}' > package.json && \
-    pnpm add pg drizzle-orm @neondatabase/serverless
+    printf '%s\n' \
+      'minimumReleaseAge: 10080' \
+      'minimumReleaseAgeStrict: true' \
+      'trustPolicy: no-downgrade' \
+      'blockExoticSubdeps: true' \
+      'strictDepBuilds: true' \
+      > pnpm-workspace.yaml && \
+    pnpm add -E pg@8.20.0 drizzle-orm@0.45.2 @neondatabase/serverless
 
 COPY . .
 
@@ -106,7 +120,7 @@ RUN pnpm exec esbuild scripts/pgSearchCleanup/index.ts --bundle --platform=node
 RUN mkdir -p /runtime-deps && cp -a node_modules/.pnpm/@swc+helpers@* /runtime-deps/
 
 ## Application image, copy all the files for production
-FROM busybox:latest AS app
+FROM busybox:1.38.0 AS app
 
 COPY --from=base /distroless/ /
 
-- 
