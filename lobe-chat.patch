diff --git a/src/libs/editor/plainText/PlainTextPlugin.ts b/src/libs/editor/plainText/PlainTextPlugin.ts
new file mode 100644
index 0000000000..29cdfe88a2
--- /dev/null
+++ b/src/libs/editor/plainText/PlainTextPlugin.ts
@@ -0,0 +1,288 @@
+import {
+  type getKernelFromEditor,
+  ILitexmlService,
+  IMarkdownShortCutService,
+} from '@lobehub/editor';
+import {
+  $createParagraphNode,
+  $createTextNode,
+  $getRoot,
+  $getSelection,
+  $isElementNode,
+  $isTextNode,
+  COMMAND_PRIORITY_CRITICAL,
+  type ElementNode,
+  FORMAT_TEXT_COMMAND,
+  type Klass,
+  type LexicalEditor,
+  type LexicalNode,
+  type TextFormatType,
+  TextNode,
+} from 'lexical';
+
+type IEditorKernel = ReturnType<typeof getKernelFromEditor>;
+
+interface DataSourceLike {
+  read: (editor: LexicalEditor, data: unknown, options?: Record<string, unknown>) => void;
+  write: (editor: LexicalEditor, options?: Record<string, unknown>) => unknown;
+}
+
+type MarkdownWriter = (ctx: any, node: LexicalNode) => boolean | void;
+
+const PATCHED = Symbol.for('msm.plainText.markdownDataSource');
+const LITEXML_PATCHED = Symbol.for('msm.plainText.litexmlReaders');
+
+/** Inline formats that still have a plain Markdown spelling; the rest are dropped. */
+const FORMAT_MARKERS: Array<[TextFormatType, string]> = [
+  ['code', '`'],
+  ['italic', '*'],
+  ['bold', '**'],
+  ['strikethrough', '~~'],
+];
+
+const stripOneTrailingNewline = (value: string) =>
+  value.endsWith('\n') ? value.slice(0, -1) : value;
+
+/**
+ * A formatted text node (from a legacy document, a collaborator, or an agent
+ * edit) turns back into its Markdown source, so it shows and saves as text.
+ */
+export const $normalizeFormattedText = (node: TextNode) => {
+  if (node.getType() !== 'text' || node.getFormat() === 0) return;
+
+  let text = node.getTextContent();
+  for (const [format, marker] of FORMAT_MARKERS) {
+    if (node.hasFormat(format)) text = `${marker}${text}${marker}`;
+  }
+
+  node.setFormat(0);
+  if (text !== node.getTextContent()) node.setTextContent(text);
+};
+
+const blockPrefix = (node: LexicalNode): string | undefined => {
+  const type = node.getType();
+  if (type === 'quote') return '> ';
+  if (type === 'heading') {
+    const tag = (node as unknown as { getTag?: () => string }).getTag?.() ?? 'h1';
+    const level = Number.parseInt(tag.slice(1), 10) || 1;
+    return `${'#'.repeat(level)} `;
+  }
+  return undefined;
+};
+
+/** A heading or quote block becomes a paragraph that starts with its Markdown marker. */
+export const $normalizeBlock = (node: ElementNode) => {
+  const prefix = blockPrefix(node);
+  if (prefix === undefined) return;
+
+  const paragraph = $createParagraphNode();
+  paragraph.append($createTextNode(prefix), ...node.getChildren());
+  node.replace(paragraph);
+};
+
+/** Text that a chip plugin's text transform may turn into a chip (e.g. `<skill … />`). */
+const mayHoldChipTag = (node: TextNode) => node.getTextContent().includes('<');
+
+const $needsPass = (node: LexicalNode): boolean => {
+  if ($isTextNode(node)) return node.getFormat() !== 0 || mayHoldChipTag(node);
+  if (!$isElementNode(node)) return false;
+  return blockPrefix(node) !== undefined || node.getChildren().some($needsPass);
+};
+
+/**
+ * Loading a document replaces the editor state without running node transforms,
+ * so normalize rich nodes here and let chip transforms see the loaded text.
+ */
+const $normalizeTree = (node: LexicalNode) => {
+  if ($isTextNode(node)) {
+    if (node.getFormat() !== 0) $normalizeFormattedText(node);
+    else if (mayHoldChipTag(node)) node.markDirty();
+    return;
+  }
+  if (!$isElementNode(node)) return;
+
+  for (const child of node.getChildren()) $normalizeTree(child);
+  if (blockPrefix(node) !== undefined) $normalizeBlock(node);
+};
+
+/** Writers that spell every node as the text the user typed. */
+const PLAIN_MARKDOWN_WRITERS: Record<string, MarkdownWriter> = {
+  heading: (ctx, node) => ctx.wrap(blockPrefix(node) ?? '', '\n'),
+  paragraph: (ctx) => ctx.wrap('', '\n'),
+  quote: (ctx) => ctx.wrap('> ', '\n'),
+  tab: (ctx) => ctx.appendLine('\t'),
+  text: (ctx, node) => {
+    if (!$isTextNode(node)) return;
+    let text = node.getTextContent();
+    for (const [format, marker] of FORMAT_MARKERS) {
+      if (node.hasFormat(format)) text = `${marker}${text}${marker}`;
+    }
+    ctx.appendLine(text);
+  },
+};
+
+const plainParagraph = (text: string) => ({
+  children: text
+    ? [{ detail: 0, format: 0, mode: 'normal', style: '', text, type: 'text', version: 1 }]
+    : [],
+  direction: null,
+  format: '',
+  indent: 0,
+  textFormat: 0,
+  textStyle: '',
+  type: 'paragraph',
+  version: 1,
+});
+
+const elementChildren = (element: Element) =>
+  Array.from(element.childNodes).filter((child): child is Element => child.nodeType === 1);
+
+const listReader = (ordered: boolean) => (element: Element) =>
+  elementChildren(element)
+    .filter((child) => child.tagName.toLowerCase() === 'li')
+    .map((item, index) =>
+      plainParagraph(`${ordered ? `${index + 1}.` : '-'} ${item.textContent?.trim() ?? ''}`),
+    );
+
+/**
+ * LiteXML (page agent, Ask Copilot) can still describe rich blocks. A plain editor
+ * has no nodes for them, so they land as their Markdown source instead of throwing.
+ */
+const PLAIN_LITEXML_READERS: Record<string, (element: Element) => unknown> = {
+  blockquote: (element) => plainParagraph(`> ${element.textContent?.trim() ?? ''}`),
+  code: (element) => ({
+    detail: 0,
+    format: 0,
+    mode: 'normal',
+    style: '',
+    text: `\`${element.textContent ?? ''}\``,
+    type: 'text',
+    version: 1,
+  }),
+  hr: () => plainParagraph('---'),
+  ol: listReader(true),
+  pre: (element) => (element.textContent ?? '').split('\n').map((line) => plainParagraph(line)),
+  table: (element) =>
+    Array.from(element.querySelectorAll('tr')).map((row) =>
+      plainParagraph(
+        Array.from(row.children)
+          .map((cell) => cell.textContent?.trim() ?? '')
+          .join(' | '),
+      ),
+    ),
+  ul: listReader(false),
+  ...Object.fromEntries(
+    [1, 2, 3, 4, 5, 6].map((level) => [
+      `h${level}`,
+      (element: Element) =>
+        plainParagraph(`${'#'.repeat(level)} ${element.textContent?.trim() ?? ''}`),
+    ]),
+  ),
+};
+
+/**
+ * Keeps an editor plain text:
+ * - formatting commands (Ctrl+B/I/U, `beforeinput` formats, toolbar buttons) do nothing;
+ * - `'markdown'` documents are read as raw text (one paragraph per line) and written
+ *   back verbatim, so loading and saving never reinterprets or escapes what was typed;
+ * - stray rich nodes (formatted text, headings, quotes) turn back into Markdown source.
+ *
+ * Inline chips and attachment blocks keep their own Markdown writers and stay intact.
+ */
+export class PlainTextPlugin {
+  static pluginName = 'MsmPlainTextPlugin';
+
+  private kernel: IEditorKernel;
+  private editor?: LexicalEditor;
+  private clears: Array<() => void> = [];
+
+  constructor(kernel: IEditorKernel) {
+    this.kernel = kernel;
+  }
+
+  onInit(editor: LexicalEditor): void {
+    this.editor = editor;
+
+    this.clears.push(
+      editor.registerCommand(FORMAT_TEXT_COMMAND, () => true, COMMAND_PRIORITY_CRITICAL),
+      editor.registerNodeTransform(TextNode, $normalizeFormattedText),
+    );
+
+    for (const type of ['heading', 'quote']) {
+      const klass = editor._nodes.get(type)?.klass as Klass<ElementNode> | undefined;
+      if (klass) this.clears.push(editor.registerNodeTransform(klass, $normalizeBlock));
+    }
+
+    this.patchMarkdownDataSource();
+    this.registerLiteXmlReaders();
+  }
+
+  onDocumentChange(): void {
+    const editor = this.editor;
+    if (!editor || !editor.getEditorState().read(() => $needsPass($getRoot()))) return;
+    editor.update(() => $normalizeTree($getRoot()), { tag: 'history-merge' });
+  }
+
+  destroy(): void {
+    for (const clear of this.clears) clear();
+    this.clears = [];
+    this.editor = undefined;
+  }
+
+  private dataSource(type: string): (DataSourceLike & { [PATCHED]?: boolean }) | undefined {
+    const map = (this.kernel as unknown as { dataTypeMap?: Map<string, DataSourceLike> })
+      .dataTypeMap;
+    return map?.get(type);
+  }
+
+  private applyPlainWriters(): void {
+    const service = this.kernel.requireService(IMarkdownShortCutService) as
+      { markdownWriters?: Record<string, MarkdownWriter> } | null | undefined;
+    const writers = service?.markdownWriters;
+    if (writers) Object.assign(writers, PLAIN_MARKDOWN_WRITERS);
+  }
+
+  private patchMarkdownDataSource(): void {
+    const markdown = this.dataSource('markdown');
+    const text = this.dataSource('text');
+    if (!markdown || !text || markdown[PATCHED]) return;
+
+    const originalWrite = markdown.write.bind(markdown);
+
+    markdown.read = (editor, data, options) =>
+      text.read(editor, typeof data === 'string' ? data : String(data ?? ''), options);
+
+    markdown.write = (editor, options) => {
+      if (options?.selection) {
+        return editor
+          .getEditorState()
+          .read(() => $getSelection()?.getTextContent().replaceAll('\uFEFF', '') ?? null);
+      }
+
+      // Other plugins register their writers during their own onInit, so the plain
+      // ones are applied right before each write rather than once up front.
+      this.applyPlainWriters();
+      const markdownText = originalWrite(editor, { ...options, format: false });
+      return typeof markdownText === 'string'
+        ? stripOneTrailingNewline(markdownText)
+        : markdownText;
+    };
+
+    markdown[PATCHED] = true;
+  }
+
+  private registerLiteXmlReaders(): void {
+    const service = this.kernel.requireService(ILitexmlService) as
+      | ({
+          registerXMLReader?: (tag: string, reader: (element: Element) => unknown) => void;
+        } & { [LITEXML_PATCHED]?: boolean })
+      | null
+      | undefined;
+    if (!service?.registerXMLReader || service[LITEXML_PATCHED]) return;
+
+    for (const [tag, reader] of Object.entries(PLAIN_LITEXML_READERS)) {
+      service.registerXMLReader(tag, reader);
+    }
+    service[LITEXML_PATCHED] = true;
+  }
+}
