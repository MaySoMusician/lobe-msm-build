@@ -0,0 +1,21 @@
+import { useLexicalComposerContext } from '@lobehub/editor';
+import { type FC, useLayoutEffect } from 'react';
+
+import { PlainTextPlugin } from './PlainTextPlugin';
+
+const ReactPlainTextPlugin: FC = () => {
+  const [editor] = useLexicalComposerContext();
+
+  useLayoutEffect(() => {
+    editor.registerPlugin(PlainTextPlugin);
+  }, [editor]);
+
+  return null;
+};
+
+ReactPlainTextPlugin.displayName = 'ReactPlainTextPlugin';
+
+export default ReactPlainTextPlugin;
+
+/** Plugins every plain-text editor loads; surfaces add their own chip and attachment plugins. */
+export const PLAIN_TEXT_PLUGINS = [ReactPlainTextPlugin];
