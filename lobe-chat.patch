From d729ef08f227b787a3855297bca43144ddb2120f Mon Sep 17 00:00:00 2001
From: MaySoMusician <maysomusician@gmail.com>
Date: Mon, 16 Nov 2026 22:04:46 +0000
Subject: [PATCH 20/22] 🏷️ fix(types): pin two order-sensitive inferences
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

`createElement` on the union of brand avatars and the i18next/plain-function
`t` union both resolve according to the order the type checker meets them,
so unrelated changes elsewhere can turn them into TS2769 / TS2589 errors.
Give each an explicit type; no runtime change.

Co-Authored-By: Claude Opus 5.5 <claude@anthropic.com.invalid>
---
 src/features/MCPApp/appHost.ts                      | 5 ++++-
 src/features/Recommendations/actions/heteroAgent.ts | 7 +++++--
 2 files changed, 9 insertions(+), 3 deletions(-)

diff --git a/src/features/MCPApp/appHost.ts b/src/features/MCPApp/appHost.ts
index 8e4e5f172a..c59648cce7 100644
--- a/src/features/MCPApp/appHost.ts
+++ b/src/features/MCPApp/appHost.ts
@@ -167,11 +167,14 @@ export const connectAppView = ({
         identifier,
         onThisDevice,
         server,
-        t,
+        t: translate,
         topicId,
         args: initiatingArgs,
         linkId: viewLinkId,
       } = getContext();
+      // One plain signature: the i18next/plain-function union can exceed the
+      // checker's instantiation depth depending on check order.
+      const t = translate as (key: string, options?: Record<string, unknown>) => string;
       const linkId = viewLinkId ?? getMcpAppLinkId(identifier, agentId, initiatingArgs);
       const policy = await getAppToolCallPolicy(identifier, name, { agentId, toolArgs, topicId });
       let allowed = policy === 'allow';
diff --git a/src/features/Recommendations/actions/heteroAgent.ts b/src/features/Recommendations/actions/heteroAgent.ts
index 7f8675d8e5..bd55aadafc 100644
--- a/src/features/Recommendations/actions/heteroAgent.ts
+++ b/src/features/Recommendations/actions/heteroAgent.ts
@@ -18,7 +18,7 @@ import {
   Qoder,
   Trae,
 } from '@lobehub/icons';
-import { createElement } from 'react';
+import { type ComponentType, createElement, type CSSProperties } from 'react';
 
 import type { RecommendedAction } from './types';
 
@@ -48,7 +48,10 @@ const avatarIcons = {
 export const buildHeteroAgentAction = (
   config: HeterogeneousAgentClientConfig,
 ): RecommendedAction => {
-  const Avatar = avatarIcons[config.type];
+  // Typed explicitly: inferring props from the union of brand avatars depends on
