index 8e2e427b60..01f1ae392d 100644
--- a/packages/mecha/src/contextEngineering/toolActivation.test.ts
+++ b/packages/mecha/src/contextEngineering/toolActivation.test.ts
@@ -31,7 +31,17 @@ describe('activation instructions in the outgoing Responses request', () => {
           apiKey: 'test',
           baseURL,
           fetch: async (_url: RequestInfo | URL, init?: RequestInit) => {
-            requests.push(JSON.parse(String(init?.body)));
+            const body = JSON.parse(String(init?.body));
+            requests.push(body);
+            // GPT requests go out non-streaming (MSM): answer with a completed response.
+            if (body.stream !== true) {
+              return Response.json({
+                id: 'resp_test',
+                object: 'response',
+                output: [],
+                status: 'completed',
+              });
+            }
             return new Response('data: [DONE]\n\n', {
               headers: { 'content-type': 'text/event-stream' },
             });
