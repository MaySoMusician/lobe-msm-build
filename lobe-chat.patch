     echo '{"name":"deps","private":true}' > package.json && \
-    pnpm add pg drizzle-orm @neondatabase/serverless
+    printf '%s\n' \
+      'minimumReleaseAge: 10080' \
+      'minimumReleaseAgeStrict: true' \
+      'trustPolicy: no-downgrade' \
+      'blockExoticSubdeps: true' \
+      'strictDepBuilds: true' \
+      > pnpm-workspace.yaml && \
+    pnpm add -E pg@8.20.0 drizzle-orm@0.45.2 @neondatabase/serverless
 
 COPY . .
 
@@ -106,7 +119,7 @@ RUN pnpm exec esbuild scripts/pgSearchCleanup/index.ts --bundle --platform=node
 RUN mkdir -p /runtime-deps && cp -a node_modules/.pnpm/@swc+helpers@* /runtime-deps/
 
