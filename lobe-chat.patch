new file mode 100644
index 0000000000..4b57db4136
--- /dev/null
+++ b/src/features/ChatInput/hooks/useTextVerbosityControl.ts
@@ -0,0 +1,57 @@
+'use client';
+
+import { useCallback } from 'react';
+
+import { useAgentStore } from '@/store/agent';
+import { chatConfigByIdSelectors } from '@/store/agent/selectors';
+import { aiModelSelectors, useAiInfraStore } from '@/store/aiInfra';
+
+import { useAgentId } from './useAgentId';
+import { useUpdateAgentConfig } from './useUpdateAgentConfig';
+
+export const TEXT_VERBOSITY_LEVELS = ['low', 'medium', 'high'] as const;
+export type TextVerbosity = (typeof TEXT_VERBOSITY_LEVELS)[number];
+
+export interface TextVerbosityControl {
+  /** True when the current model card lists the `textVerbosity` extend param. */
+  available: boolean;
+  levels: readonly TextVerbosity[];
+  select: (value: TextVerbosity) => void;
+  /** Saved agent value, or Medium when nothing has been chosen yet. */
+  value: TextVerbosity;
+}
+
+const isTextVerbosity = (value: string | undefined): value is TextVerbosity =>
+  !!value && (TEXT_VERBOSITY_LEVELS as readonly string[]).includes(value);
+
+/**
+ * Output text verbosity for the chat-input model menu.
+ *
+ * Unlike reasoning effort, this stays on the agent chat config — the same field
+ * the desktop slider writes — so both controls stay in sync and the send path
+ * already forwards it when the model declares `textVerbosity`.
+ */
+export const useTextVerbosityControl = (model: string, provider: string): TextVerbosityControl => {
+  const agentId = useAgentId();
+  const extendParams = useAiInfraStore(aiModelSelectors.modelExtendParams(model, provider));
+  const saved = useAgentStore(
+    (s) => chatConfigByIdSelectors.getChatConfigById(agentId)(s).textVerbosity,
+  );
+  const { updateAgentChatConfig } = useUpdateAgentConfig();
+
+  const select = useCallback(
+    (value: TextVerbosity) => {
+      void updateAgentChatConfig({ textVerbosity: value }).catch((error) => {
+        console.error(error);
+      });
+    },
+    [updateAgentChatConfig],
+  );
+
+  return {
+    available: (extendParams ?? []).includes('textVerbosity'),
+    levels: TEXT_VERBOSITY_LEVELS,
+    select,
+    value: isTextVerbosity(saved) ? saved : 'medium',
+  };
+};
-- 
