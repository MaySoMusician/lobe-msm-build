diff --git a/src/features/EditorCanvas/ReadOnlyMarkdown.tsx b/src/features/EditorCanvas/ReadOnlyMarkdown.tsx
new file mode 100644
index 0000000000..bfc11f29e7
--- /dev/null
+++ b/src/features/EditorCanvas/ReadOnlyMarkdown.tsx
@@ -0,0 +1,105 @@
+'use client';
+
+import type { IEditor } from '@lobehub/editor';
+import { type MarkdownProps } from '@lobehub/ui';
+import { type CSSProperties, memo, useEffect, useState } from 'react';
+
+import MarkdownMessage from '@/features/Conversation/Markdown';
+import { markdownElements } from '@/features/Conversation/Markdown/plugins';
+
+// Same elements a sent user message renders, so chip tags (`<mention … />`,
+// `<refer_topic … />`, skills, tools, local files) show as chips here too.
+const userElements = markdownElements.filter((element) => element.scope !== 'assistant');
+
+const MARKDOWN_PROPS = {
+  components: Object.fromEntries(
+    userElements.map((element) => {
+      const Component = element.Component;
+      return [element.tag, (props: any) => <Component {...props} id={''} />];
+    }),
+  ) as any,
+  enableStream: false,
+  rehypePlugins: userElements.map((element) => element.rehypePlugin).filter(Boolean),
+  remarkPlugins: userElements.map((element) => element.remarkPlugin).filter(Boolean),
+} satisfies Partial<MarkdownProps>;
+
+const LIVE_DEBOUNCE_MS = 150;
+
+const readEditorMarkdown = (editor?: IEditor): string | undefined => {
+  if (!editor?.getLexicalEditor?.()) return undefined;
+  try {
+    const markdown = editor.getDocument('markdown');
+    return typeof markdown === 'string' ? markdown : undefined;
+  } catch {
+    return undefined;
+  }
+};
+
+/**
+ * Follow the (hidden, still mounted) editor's document, so a read-only view stays
+ * current while a collaborator or agent writes; `fallback` covers the time before
+ * the editor holds a document.
+ */
+const useLiveMarkdown = (editor: IEditor | undefined, fallback: string): string => {
+  const [markdown, setMarkdown] = useState(() => readEditorMarkdown(editor) ?? fallback);
+
+  useEffect(() => {
+    if (!editor) return;
+
+    let timer: ReturnType<typeof setTimeout> | undefined;
+    let unregister: (() => void) | undefined;
+
+    const refresh = () => setMarkdown(readEditorMarkdown(editor) ?? fallback);
+    const subscribe = () => {
+      unregister?.();
+      unregister = editor
+        .getLexicalEditor?.()
+        ?.registerUpdateListener(({ dirtyElements, dirtyLeaves }) => {
+          if (dirtyElements.size === 0 && dirtyLeaves.size === 0) return;
+          clearTimeout(timer);
+          timer = setTimeout(refresh, LIVE_DEBOUNCE_MS);
+        });
+      refresh();
+    };
+
+    subscribe();
+    editor.on('initialized', subscribe);
+    editor.on('documentChange', refresh);
+
+    return () => {
+      clearTimeout(timer);
+      unregister?.();
+      editor.off('initialized', subscribe);
+      editor.off('documentChange', refresh);
+    };
+  }, [editor, fallback]);
+
+  return editor ? markdown : fallback;
+};
+
+interface ReadOnlyMarkdownProps {
+  className?: string;
+  /** Stored Markdown; shown until (or without) a live editor. */
+  content?: string;
+  /** When given, the view follows this editor's document. */
+  editor?: IEditor;
+  style?: CSSProperties;
+}
+
+/**
+ * Read-only rendering of a plain-text document's Markdown. Editors stay plain
+ * text; surfaces that only display a document render it richly with this.
+ */
+const ReadOnlyMarkdown = memo<ReadOnlyMarkdownProps>(({ className, content, editor, style }) => {
+  const markdown = useLiveMarkdown(editor, content ?? '');
+
+  return (
+    <div data-plain-markdown-body className={className} style={style}>
+      <MarkdownMessage {...MARKDOWN_PROPS}>{markdown}</MarkdownMessage>
+    </div>
+  );
+});
+
+ReadOnlyMarkdown.displayName = 'ReadOnlyMarkdown';
+
+export default ReadOnlyMarkdown;
