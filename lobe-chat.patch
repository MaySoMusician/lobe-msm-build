From dee332a80e0852d16ae9c31fc274a20d4c0cd8aa Mon Sep 17 00:00:00 2001
From: MaySoMusician <maysomusician@gmail.com>
Date: Thu, 12 Nov 2026 23:25:10 +0000
Subject: [PATCH 01/22] 🔒️ build(docker): pin images and harden the image
 install
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Co-Authored-By: Claude Opus 5.5 <claude@anthropic.com.invalid>
---
 .dockerignore |  1 +
 Dockerfile    | 22 ++++++++++++++++++----
 2 files changed, 19 insertions(+), 4 deletions(-)

diff --git a/.dockerignore b/.dockerignore
index fc4c2e7966..020c7d1022 100644
--- a/.dockerignore
+++ b/.dockerignore
@@ -1,6 +1,7 @@
 Dockerfile
 .dockerignore
 node_modules
+.pnpm-store
 npm-debug.log
 .next
 .git
diff --git a/Dockerfile b/Dockerfile
index 0ecae9e760..f043172253 100644
--- a/Dockerfile
+++ b/Dockerfile
@@ -1,9 +1,13 @@
 ## Set global build ENV
-ARG NODEJS_VERSION="24"
+ARG NODEJS_VERSION="24.22.3"
 
 ## Base image for all building stages
 FROM node:${NODEJS_VERSION}-slim AS base
 
+ENV PNPM_CONFIG_FETCH_RETRIES=5
+ENV PNPM_CONFIG_FETCH_RETRY_MINTIMEOUT=30000
+ENV PNPM_CONFIG_NETWORK_CONCURRENCY=8
+
 ARG USE_CN_MIRROR
 
 ENV DEBIAN_FRONTEND="noninteractive"
@@ -30,6 +34,7 @@ RUN set -e && \
 FROM base AS builder
 
 ARG USE_CN_MIRROR
+ARG NPM_REGISTRY=""
 ARG NEXT_PUBLIC_BASE_PATH
 ARG NEXT_PUBLIC_SENTRY_DSN
 ARG NEXT_PUBLIC_ANALYTICS_UMAMI
@@ -79,15 +84,24 @@ RUN set -e && \
         npm config set registry "https://registry.npmmirror.com/"; \
         echo 'canvas_binary_host_mirror=https://npmmirror.com/mirrors/canvas' >> .npmrc; \
     fi && \
+    if [ -n "${NPM_REGISTRY:-}" ]; then \
+        npm config set registry "${NPM_REGISTRY}"; \
+    fi && \
     export COREPACK_NPM_REGISTRY=$(npm config get registry | sed 's/\/$//') && \
-    npm i -g corepack@latest && \
     corepack enable && \
     corepack use $(sed -n 's/.*"packageManager": "\(.*\)".*/\1/p' package.json) && \
     pnpm i && \
     mkdir -p /deps && \
     cd /deps && \
     echo '{"name":"deps","private":true}' > package.json && \
-    pnpm add pg drizzle-orm @neondatabase/serverless
+    printf '%s\n' \
+      'minimumReleaseAge: 10080' \
+      'minimumReleaseAgeStrict: true' \
+      'trustPolicy: no-downgrade' \
+      'blockExoticSubdeps: true' \
+      'strictDepBuilds: true' \
+      > pnpm-workspace.yaml && \
+    pnpm add -E pg@8.20.0 drizzle-orm@0.45.2 @neondatabase/serverless
 
 COPY . .
 
@@ -106,7 +120,7 @@ RUN pnpm exec esbuild scripts/pgSearchCleanup/index.ts --bundle --platform=node
 RUN mkdir -p /runtime-deps && cp -a node_modules/.pnpm/@swc+helpers@* /runtime-deps/
 
 ## Application image, copy all the files for production
-FROM busybox:latest AS app
+FROM busybox:1.38.0 AS app
 
 COPY --from=base /distroless/ /
 
-- 
2.39.5


From f195ff41966cb7d475fe88eb1465b6c91860374d Mon Sep 17 00:00:00 2001
From: MaySoMusician <maysomusician@gmail.com>
Date: Thu, 26 Nov 2026 21:32:02 +0000
Subject: [PATCH 02/22] 🔒️ build(deps): enforce mature trusted dependency
 resolution
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Every workspace now refuses packages younger than 7 days
(minimumReleaseAge, strict) and trust downgrades (trustPolicy:
no-downgrade), blocks exotic subdependencies and requires approved build
scripts. Exceptions are exact versions only.

The patched @lobehub/ui pins open-bot-avatar@0.3.0 and @pierre/diffs@1.7.1
exactly, and @pierre/diffs pins @pierre/highlights@0.5.2 and
@pierre/theme@2.1.0 exactly; upstream's request-filtering-agent ^3.3.1
resolves to 3.3.1, and @lobehub/charts (age-excluded upstream with every
@lobehub/* package) requires lucide-react ^1.80.0. All are younger than the
gate, so they are excluded by exact version until they age. Upstream's own
better-auth excludes stay. @pierre/theme@2.1.0 also needs the trust
exception 2.0.0 had: same publisher, still without provenance.

Co-Authored-By: Claude Opus 5.5 <claude@anthropic.com.invalid>
---
 apps/cli/pnpm-workspace.yaml     | 23 +++++++++++++++++++
 apps/desktop/pnpm-workspace.yaml | 23 +++++++++++++++++++
 pnpm-workspace.yaml              | 39 +++++++++++++++++++++++++++++++-
 3 files changed, 84 insertions(+), 1 deletion(-)

