+/**
+ * `<Editor>` props that keep a `@lobehub/editor` surface plain text: no Markdown
+ * typing shortcuts, no Markdown or VS Code paste conversion, and pastes land as
+ * plain text. Pair with `PLAIN_TEXT_PLUGINS` (or `ReactPlainTextPlugin`), which
+ * blocks formatting commands and stores the text verbatim.
+ *
+ * Kept free of value imports so heavily mocked tests can import it.
+ */
+export const PLAIN_TEXT_EDITOR_PROPS = {
+  autoFormatMarkdown: false,
+  enablePasteMarkdown: false,
+  markdownOption: false,
+  pasteAsPlainText: true,
+  pasteVSCodeAsCodeBlock: false,
+} as const;
