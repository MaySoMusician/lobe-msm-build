         onClick: () => handleLangChange('auto'),
       },
-      ...localeOptions.map((item) => ({
-        key: item.value,
-        label: item.label,
-        onClick: () => handleLangChange(item.value),
-      })),
+      ...localeOptions
+        .filter((item) => ['en-US', 'ja-JP'].includes(item.value))
