+function convertNonStreamingResponseToStreamEvents(
+  nonStreamingResponse: OpenAI.Responses.Response,
+): OpenAI.Responses.ResponseStreamEvent[] {
+  const events: OpenAI.Responses.ResponseStreamEvent[] = [];
+  let seq = 1;
+
+  // 1. First, create the "response.created" event.
+  events.push({
+    response: {
+      created_at: 0, // dummy placeholder
+      error: null, // dummy placeholder
+      id: nonStreamingResponse.id,
+      incomplete_details: null, // dummy placeholder
+      instructions: null, // dummy placeholder
+      metadata: null, // dummy placeholder
+      model: '', // dummy placeholder
+      object: 'response', // dummy placeholder
+      output: [], // dummy placeholder
+      output_text: '', // dummy placeholder
+      parallel_tool_calls: false, // dummy placeholder
+      status:
+        nonStreamingResponse.status === 'completed' ? 'in_progress' : nonStreamingResponse.status,
+      temperature: null, // dummy placeholder
+      tool_choice: 'auto', // dummy placeholder
+      tools: [], // dummy placeholder
+      top_p: null, // dummy placeholder
+      usage: undefined,
+    },
+    sequence_number: seq++,
+    type: 'response.created',
+  });
+
+  // 2. Traverse the output array and generate events according to each item's type.
+  for (const item of nonStreamingResponse.output) {
+    // Send the "response.output_item.added" event first.
+    events.push({
+      item: {
+        arguments: (item as any).arguments,
+        call_id: (item as any).call_id,
+        content: (item as any).content,
+        id: item.id,
+        name: (item as any).name,
+        role: (item as any).role,
+        status: (item as any).status,
+        summary: (item as any).summary,
+        type: item.type,
+      },
+      sequence_number: seq++,
+      type: 'response.output_item.added',
+    } as any);
+
+    // Branch processing according to item.type.
+    switch (item.type) {
+      case 'function_call': {
+        // In src/utils/fetch/fetchSSE.ts, the argument duplication occurs during parse, so we won't send a delta.
+        events.push({
+          item: {
+            arguments: item.arguments, // dummy placeholder
+            call_id: item.call_id,
+            id: item.id,
+            name: '', // dummy placeholder
+            type: 'function_call',
+          },
+          output_index: 1,
+          sequence_number: seq++,
+          type: 'response.output_item.done',
+        });
+        break;
+      }
+
+      case 'message': {
+        // For "message" type, send the entire content as a single "response.output_text.delta" event.
+        if (item.content) {
+          for (const contentObj of item.content) {
+            if (contentObj.type === 'output_text') {
+              // Combine text into a single delta.
+              events.push({
+                content_index: 1, // dummy placeholder
+                delta: contentObj.text,
+                item_id: item.id,
+                output_index: 1, // dummy placeholder
+                sequence_number: seq++,
+                type: 'response.output_text.delta',
+              });
+
+              // If there are annotations, send them individually as "response.output_text.annotation.added" events.
+              if (Array.isArray(contentObj.annotations)) {
+                for (const ann of contentObj.annotations) {
+                  const ann2 = ann as OpenAI.Responses.ResponseOutputText.URLCitation;
+                  events.push({
+                    annotation: {
+                      end_index: ann2.end_index,
+                      start_index: ann2.start_index,
+                      title: ann2.title,
+                      type: 'url_citation',
+                      url: ann2.url,
+                    },
+                    item_id: item.id,
+                    sequence_number: seq++,
+                    type: 'response.output_text.annotation.added' as any,
+                  });
+                }
               }
-              break;
             }
           }
+        }
+
+        // Finally, send "response.output_item.done".
+        events.push({
+          item: {
+            content: [], // dummy placeholder
+            id: item.id,
+            role: 'assistant', // dummy placeholder
+            status: 'in_progress', // dummy placeholder
+            type: 'message',
+          },
+          output_index: 1, // dummy placeholder
+          sequence_number: seq++,
+          type: 'response.output_item.done',
         });
+        break;
       }
 
-      // Always send response.completed event
-      controller.enqueue({
-        response: data,
-        sequence_number: 999,
-        type: 'response.completed',
-      } as OpenAI.Responses.ResponseStreamEvent);
+      case 'reasoning': {
+        // For "reasoning" type, send the summary all at once.
+        // (In transformOpenAIStream, the events go in the order "response.reasoning_summary_part.added" -> "response.reasoning_summary_text.delta" -> done.)
+        events.push({
+          item_id: item.id,
+          output_index: 1, // dummy placeholder
+          part: {
+            text: '', // dummy placeholder
+            type: 'summary_text',
+          },
+          sequence_number: seq++,
+          summary_index: 1, // dummy placeholder
+          type: 'response.reasoning_summary_part.added',
+        });
 
+        // If there's a summary array, concatenate it into a single delta.
+        const entireSummary = Array.isArray(item.summary) ? item.summary.join('\n') : '';
+        if (entireSummary) {
+          events.push({
+            delta: entireSummary,
+            item_id: item.id,
+            output_index: 1, // dummy placeholder
+            sequence_number: seq++,
+            summary_index: 1, // dummy placeholder
+            type: 'response.reasoning_summary_text.delta',
+          });
+        }
+
+        events.push({
+          item: {
+            id: item.id,
+            summary: [], // dummy placeholder
+            type: 'reasoning',
+          },
+          output_index: 1, // dummy placeholder
+          sequence_number: seq++,
+          type: 'response.output_item.done',
+        });
+        break;
+      }
+
+      default: {
+        // For an unknown type, just send "response.output_item.done".
+        events.push({
+          item: {
+            id: item.id,
+            type: item.type,
+          },
+          sequence_number: seq++,
+          type: 'response.output_item.done',
+        } as any);
+        break;
+      }
+    }
+  }
+
+  // 3. Finally, send the "response.completed" event.
+  events.push({
+    response: {
+      created_at: 0, // dummy placeholder
+      error: null, // dummy placeholder
+      id: nonStreamingResponse.id,
+      incomplete_details: null, // dummy placeholder
+      instructions: null, // dummy placeholder
+      metadata: null, // dummy placeholder
+      model: '', // dummy placeholder
+      object: 'response', // dummy placeholder
+      output: [], // dummy placeholder
+      output_text: '', // dummy placeholder
+      parallel_tool_calls: false, // dummy placeholder
+      temperature: null, // dummy placeholder
+      tool_choice: 'auto', // dummy placeholder
+      tools: [], // dummy placeholder
+      top_p: null, // dummy placeholder
+      usage: nonStreamingResponse.usage ?? undefined,
