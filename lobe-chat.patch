From e3e496c46d886c9ecd03ae8961dff1386598a256 Mon Sep 17 00:00:00 2001
From: MaySoMusician <maysomusician@gmail.com>
Date: Thu, 26 Nov 2026 15:36:26 +0000
Subject: [PATCH 22/22] ✨ feat(ui): show message usage by default
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The model and token usage row under replies shows unless the user turns
off "Show model and token usage" in Settings > Conversation > Display,
instead of following the retired Advanced Tools switch.

Co-Authored-By: Claude Opus 5.5 <claude@anthropic.com.invalid>
---
 .../user/slices/settings/selectors/general.test.ts   | 12 ++++++------
 src/store/user/slices/settings/selectors/general.ts  |  8 ++------
 2 files changed, 8 insertions(+), 12 deletions(-)

diff --git a/src/store/user/slices/settings/selectors/general.test.ts b/src/store/user/slices/settings/selectors/general.test.ts
index 16932cc5cb..6f745b350e 100644
--- a/src/store/user/slices/settings/selectors/general.test.ts
+++ b/src/store/user/slices/settings/selectors/general.test.ts
@@ -45,21 +45,21 @@ describe('settingsSelectors', () => {
   });
 
   describe('showMessageUsage', () => {
-    it('is off when nothing was chosen', () => {
-      expect(userGeneralSettingsSelectors.showMessageUsage(initialState as UserStore)).toBe(false);
+    it('is on when nothing was chosen', () => {
+      expect(userGeneralSettingsSelectors.showMessageUsage(initialState as UserStore)).toBe(true);
     });
 
-    it('keeps it on for people who had the retired Advanced Tools switch on', () => {
+    it('stays on whatever the retired Advanced Tools switch says', () => {
       const s = merge(initialState, {
-        settings: { general: { isDevMode: true } },
+        settings: { general: { isDevMode: false } },
       }) as unknown as UserStore;
 
       expect(userGeneralSettingsSelectors.showMessageUsage(s)).toBe(true);
     });
 
-    it('lets the explicit choice win over the retired switch', () => {
+    it('lets the user turn it off', () => {
       const s = merge(initialState, {
-        settings: { general: { isDevMode: true, showMessageUsage: false } },
+        settings: { general: { showMessageUsage: false } },
       }) as unknown as UserStore;
 
       expect(userGeneralSettingsSelectors.showMessageUsage(s)).toBe(false);
diff --git a/src/store/user/slices/settings/selectors/general.ts b/src/store/user/slices/settings/selectors/general.ts
index 3d6705c301..bbbec1470d 100644
--- a/src/store/user/slices/settings/selectors/general.ts
+++ b/src/store/user/slices/settings/selectors/general.ts
