@@ -26,6 +26,25 @@ const hasAudioInput = (payload: ChatStreamPayload) =>
       Array.isArray(message.content) && message.content.some((part) => part.type === 'audio_url'),
   );
 
+const isOpenAIProviderGPTModel = (model: string): boolean => {
+  const normalized = model.trim().toLowerCase();
+  const bareModel = normalized.startsWith('codex/')
+    ? normalized.slice('codex/'.length)
+    : normalized.startsWith('openai/')
+      ? normalized.slice('openai/'.length)
+      : normalized;
+
+  return bareModel.startsWith('gpt-');
+};
+
+const resolveOpenAIStream = (model: string, requested?: boolean) =>
+  isOpenAIProviderGPTModel(model) ? false : (requested ?? true);
+
+const pruneOpenAIReasoningPayload = (payload: ChatStreamPayload) => {
+  const pruned = pruneReasoningPayload(payload);
+  return isOpenAIProviderGPTModel(payload.model) ? { ...pruned, stream: false } : pruned;
+};
+
 const oaiSearchContextSize = process.env.OPENAI_SEARCH_CONTEXT_SIZE; // low, medium, high
