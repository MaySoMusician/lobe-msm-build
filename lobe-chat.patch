+export const DEFAULT_OPENAI_TIMEOUT = 3_600_000;
+
+export interface OpenAIClientNetworkOptions {
+  fetch?: typeof fetch;
+  fetchOptions?: { dispatcher: unknown };
+  timeout: number;
